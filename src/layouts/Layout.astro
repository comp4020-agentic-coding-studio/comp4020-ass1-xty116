---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "An interactive explainer built for ANU COMP4020.",
} = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111d" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
